# Segredos das Edge Functions de assinatura (preencha em supabase/functions/.env, que não vai para o Git)
# Chave da API da ZapSign (Configurações > Integrações > API ZapSign)
ZAPSIGN_API_TOKEN=
# Segredo do aviso (webhook): o mesmo valor vai no cabeçalho X-Webhook-Secret configurado na ZapSign
ZAPSIGN_WEBHOOK_SEGREDO=
# Endereço da API: https://sandbox.zapsign.com.br (testes, padrão) ou https://api.zapsign.com.br (produção)
ZAPSIGN_URL=
